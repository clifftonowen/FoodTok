<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="6dp"
    android:background="@drawable/bg_ingredient_row"
    android:gravity="center_vertical"
    android:minHeight="50dp"
    android:orientation="horizontal"
    android:paddingStart="8dp"
    android:paddingEnd="12dp"
    android:paddingVertical="5dp">

    <CheckBox
        android:id="@+id/ingredientCheck"
        android:layout_width="36dp"
        android:layout_height="40dp"
        android:buttonTint="@color/foodtok_green"
        android:gravity="center" />

    <TextView
        android:id="@+id/ingredientIcon"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:gravity="center"
        android:textSize="21sp" />

    <TextView
        android:id="@+id/ingredientName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_weight="1"
        android:textColor="@color/foodtok_text_primary"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/ingredientQuantity"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:gravity="end"
        android:textColor="@color/foodtok_text_secondary"
        android:textSize="13sp" />
</LinearLayout>
