<resources>
    <style name="Theme.FoodTok" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand color (green) -->
        <item name="colorPrimary">@color/foodtok_green</item>
        <item name="colorPrimaryVariant">@color/foodtok_green_dark</item>
        <item name="colorOnPrimary">@color/foodtok_text_on_dark</item>

        <!-- Accent color (orange) -->
        <item name="colorSecondary">@color/foodtok_orange</item>
        <item name="colorSecondaryVariant">@color/foodtok_orange_dark</item>
        <item name="colorOnSecondary">@color/foodtok_text_on_dark</item>

        <!-- Background -->
        <item name="android:colorBackground">@color/foodtok_cream</item>
        <item name="colorSurface">@color/foodtok_white</item>
        <item name="colorOnSurface">@color/foodtok_text_primary</item>

        <!-- Error -->
        <item name="colorError">@color/foodtok_error</item>

        <!-- Status bar -->
        <item name="android:statusBarColor">@android:color/black</item>
        <item name="android:navigationBarColor">@android:color/black</item>
        <item name="android:windowLightStatusBar">false</item>

        <!-- Global typography -->
        <item name="fontFamily">@font/poppins</item>
        <item name="android:fontFamily">@font/poppins</item>
    </style>

    <style name="TextAppearance.FoodTok.BottomNav"
        parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:fontFamily">@font/poppins_medium</item>
        <item name="fontFamily">@font/poppins_medium</item>
        <item name="android:textSize">10sp</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="ShapeAppearanceOverlay.FoodTok.Circle" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>
</resources>
